{
  "name": "deepseek-harness-plugins",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
